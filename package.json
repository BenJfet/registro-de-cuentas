{
  "name": "registro-de-cuentas",
  "version": "1.0.0",
  "description": "Registro diario de ventas y caja para un negocio de comida: reemplaza el cuaderno por una app web con base de datos.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.4"
  }
}
